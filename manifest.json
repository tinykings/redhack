{
  "manifest_version": 3,
  "name": "RedHack Feed",
  "version": "0.1.0",
  "description": "Top posts from your subscribed subreddits interleaved with Hacker News.",
  "action": {
    "default_title": "Open RedHack feed"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.reddit.com/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "redhack@localhost"
    }
  }
}
